{
  "name": "@wanghailong0419/dsh-toolkit",
  "description": "DSH toolkit bundle: installs dsh-mcp-manager + dsh-skill-manager with a single `dsh plugin --profile web add`",
  "version": "0.1.6",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./mcp": {
      "default": "./lib/mcp.js"
    },
    "./mcp/client": {
      "default": "./lib/mcp-client.js"
    },
    "./skill": {
      "default": "./lib/skill.js"
    },
    "./skill/client": {
      "default": "./lib/skill-client.js"
    },
    "./mcp/package.json": "./package.json",
    "./skill/package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mcp.js",
    "lib/mcp-client.js",
    "lib/skill.js",
    "lib/skill-client.js",
    "cordis.patch.yml",
    "docs/",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "mcp",
    "skill",
    "toolkit",
    "plugin"
  ],
  "dependencies": {
    "@wanghailong0419/dsh-mcp-manager": "^0.1.3",
    "@wanghailong0419/dsh-skill-manager": "^0.1.4"
  }
}
